# Copy this file to .env and fill in real values.
# config.py fails fast at startup if any of these are missing.

# --- LLMs ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=deepseek-r1-distill-llama-70b   # used only for compaction/summarization

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite          # main chat agent LLM

# --- Embeddings (NVIDIA build.nvidia.com) ---
NVIDIA_API_KEY=your_nvidia_api_key_here
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_MODEL_URL=https://integrate.api.nvidia.com/v1/embeddings
EMBEDDING_MODEL_DIMENSION=1024

# --- Ingestion sources ---
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# --- Storage (both under ./data/, kept out of git — see .gitignore) ---
QDRANT_PATH=./data/qdrant_db
SQLITE_CONNECTION_PATH=./data/sqlite_connection_path.db

# --- Ingestion cap ---
# Hard per-set limit on total chunks; ingesting a page that would push a set
# over this returns a 400 instead of embedding it.
MAX_CHUNKS=150

# --- Tiered memory ---
# Number of most-recent messages (per set) kept in SQLite / injected into the
# prompt directly. Once a set's message count exceeds this, the oldest 3/4
# get summarized and moved into that set's Qdrant _memory collection.
RECENT_MESSAGES_LIMIT=20
